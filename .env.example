APP_NAME=Vard API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_BASE_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006

DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require&channel_binding=require
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_API_KEY=your-onesignal-rest-api-key

# Camera RTSP usada pelo detector de quedas quando --source for omitido.
# Exemplo: rtsp://usuario:senha@192.168.0.10:554/stream0
# Em uma instalacao com Tailscale, este valor normalmente continua sendo o IP local
# da camera. O computador/Raspberry local roda Tailscale e funciona como ponte.
VARD_RTSP_URL=

# Jobs Python de monitoramento de queda por camera cadastrada.
# Quando habilitado, a API sobe um supervisor que cria um job por camera ativa.
FALL_MONITOR_ENABLED=false
FALL_MONITOR_CHECKPOINT=fall_detection/models/vard_fall_window_production.pkl
FALL_MONITOR_DEVICE=
FALL_MONITOR_RELOAD_SECONDS=15
FALL_MONITOR_NUM_FRAMES=16
FALL_MONITOR_SAMPLE_FPS=6
FALL_MONITOR_CAPTURE_FPS=0
FALL_MONITOR_STRIDE_SECONDS=1
FALL_MONITOR_THRESHOLD=0.85
FALL_MONITOR_SMOOTHING_WINDOW=5
FALL_MONITOR_MIN_CONSECUTIVE_HITS=2
FALL_MONITOR_BUFFER_SECONDS=8
FALL_MONITOR_FREEZE_SECONDS=300
FALL_MONITOR_SHOW_PREVIEW=false
FALL_MONITOR_ALERT_COOLDOWN_SECONDS=300
FALL_MONITOR_RESTART_BACKOFF_SECONDS=30
